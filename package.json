{
    "name": "@wxn0brp/vql",
    "version": "0.13.3",
    "main": "dist/index.js",
    "author": "wxn0brP",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "tsc && tsc-alias",
        "test": "bun run src/tests/index.ts",
        "types": "api-extractor run --config config/api-extractor.json && sed -i -E 's/^([[:space:]]*)declare([[:space:]]|\\(|;|$)/\\1export declare\\2/' dist/vql.d.ts"
    },
    "description": "VQL - Valthera Query Language",
    "homepage": "https://github.com/wxn0brP/VQL",
    "repository": {
        "type": "git",
        "url": "https://github.com/wxn0brP/VQL.git"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "vql",
        "valthera",
        "database",
        "orm",
        "api",
        "crud",
        "nosql",
        "query",
        "db",
        "query-language"
    ],
    "peerDependencies": {
        "@wxn0brp/db-core": "^0.12.12",
        "@wxn0brp/falcon-frame": "^0.9.7",
        "@wxn0brp/gate-warden": "^0.7.1"
    },
    "peerDependenciesMeta": {
        "@wxn0brp/falcon-frame": {
            "optional": true
        },
        "@wxn0brp/db-core": {
            "optional": false
        },
        "@wxn0brp/gate-warden": {
            "optional": true
        }
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.4",
        "@types/bun": "*",
        "@types/node": "*",
        "@wxn0brp/biome": "*",
        "@wxn0brp/db": "^0.120.5",
        "@wxn0brp/db-core": "^0.12.12",
        "@wxn0brp/falcon-frame": "^0.9.7",
        "@wxn0brp/gate-warden": "^0.7.1",
        "esbuild": "^0.28",
        "tsc-alias": "^1",
        "typescript": "^7"
    },
    "dependencies": {
        "@wxn0brp/lucerna-log": "^0.2.5"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    }
}
